# ──────────────────────────────────────────────────────────────────────────────
# SAP AI Agent — Environment Variables
# Copy this file to .env and fill in real values.
# NEVER commit .env to version control.
# ──────────────────────────────────────────────────────────────────────────────

# ── REQUIRED IN PRODUCTION ────────────────────────────────────────────────────

# Cryptographically random string, minimum 32 characters.
# Generate: python -c "import secrets; print(secrets.token_hex(32))"
JWT_SECRET_KEY=

# Separate secret for refresh tokens (different from access token secret).
# Generate: python -c "import secrets; print(secrets.token_hex(32))"
JWT_REFRESH_SECRET=

# Comma-separated list of allowed CORS origins. Required in production.
# Example: https://sap-agent.mycompany.com,https://admin.mycompany.com
CORS_ORIGINS=http://localhost:5173

# ── OPTIONAL / DEFAULTS SHOWN ─────────────────────────────────────────────────

# Application environment: development | staging | production
# Controls whether dev-only overrides (DISABLE_AUTH) are allowed.
APP_ENV=development

# JWT access token lifetime in hours. Default: 1
JWT_EXPIRE_HOURS=1

# JWT refresh token lifetime in days. Default: 7
JWT_REFRESH_EXPIRE_DAYS=7

# Server bind address. Use 127.0.0.1 (loopback) unless behind a reverse proxy.
# Change to 0.0.0.0 ONLY when running in a container with a reverse proxy.
HOST=127.0.0.1
PORT=8000

# Peers whose X-Forwarded-For header is believed, as a comma-separated list.
# LEAVE THIS EMPTY unless a reverse proxy actually terminates in front of the
# app. The value lands verbatim in the audit trail as the caller's IP, so
# trusting a peer that is not a proxy lets any client forge its own identity
# in the SOX/GDPR log. If the app binds 127.0.0.1 and you list 127.0.0.1 here,
# every direct client qualifies as the trusted proxy.
TRUSTED_PROXY_IPS=

# ── DEV ONLY (never set these in staging/production) ──────────────────────────

# Disable authentication. ONLY accepted when APP_ENV=development.
DISABLE_AUTH=false

# ── CLOUD LLM FALLBACK ────────────────────────────────────────────────────────
# If Ollama/MLX is unreachable, the agent automatically falls back to these.
# Leave blank to disable cloud fallback (Ollama-only mode).

OPENAI_API_KEY=
OPENAI_FALLBACK_MODEL=gpt-4o-mini

ANTHROPIC_API_KEY=
ANTHROPIC_FALLBACK_MODEL=claude-haiku-4-5

# ── OLLAMA ────────────────────────────────────────────────────────────────────
# Override only if Ollama is running on a non-default host/port.
# OLLAMA_URL=http://localhost:11434

# ── CACHE / SCALE (Redis) ─────────────────────────────────────────────────────
# Caches chat answers + chart payloads to cut repeat LLM calls (a scale lever).
# Leave REDIS_URL blank to run without caching (the app degrades gracefully).
# Sensitive tool results (payslips, PII, financials) and any secret-bearing
# responses are NEVER cached — see core/security.classify_for_cache.
REDIS_URL=
# REDIS_URL=redis://localhost:6379/0
CACHE_TTL_SECONDS=3600

# ── POSTGRESQL DATABASE ───────────────────────────────────────────────────────
# Run db/schema.sql then db/seed.sql to set up the database.
# The port below is PostgreSQL's default. Check what your instance actually
# listens on (`lsof -nP -iTCP -sTCP:LISTEN | grep postgres`) — a wrong port
# here does not stop the app from starting, it just makes every database
# write fail.
DB_HOST=localhost
DB_PORT=5432
DB_USER=sap_agent
DB_PASSWORD=change-me
DB_NAME=sap_agent
# Connection pool size. Default: 5
DB_POOL_SIZE=5
# Seconds a caller waits for a pooled connection before failing. Default: 3.
# psycopg's own default is 30, which is long enough that a database outage
# looks like a hung server rather than a failing one.
DB_POOL_TIMEOUT=3
# TLS to the database. Defaults to `require` outside APP_ENV=development.
# Only lower it for a loopback connection to a local instance that has no TLS
# configured — never for a database reached over a network.
# DB_SSLMODE=prefer
